DATABASE_URL=postgres://recall:recall@localhost:5433/recall
RUST_LOG=info,recall=debug
RECALL_BIND=127.0.0.1:8080
# key:user_id pairs, comma-separated
RECALL_API_KEYS=sk-local-admin:admin
# Optional: user ids that may read any run (audit API traffic)
RECALL_ADMIN_USERS=admin

# Models. Each port names its backend, with no default, so a missing .env fails at startup instead of picking Bedrock.
# A setting the chosen backend does not use is also an error: keep exactly one block below uncommented, and source
# .env in a fresh shell after switching. Check the result with `recall models check`.

# Local: Ollama for embeddings and Explain, Kev for System One. See README, "Running fully locally".
RECALL_EMBED_BACKEND=openai-compatible
RECALL_EMBED_URL=http://localhost:11434/v1
RECALL_EMBED_MODEL=bge-m3
RECALL_EXPLAIN_BACKEND=openai-compatible
RECALL_EXPLAIN_URL=http://localhost:11434/v1
RECALL_EXPLAIN_MODEL=qwen3:14b
RECALL_SYSTEM_ONE_BACKEND=system-one
RECALL_SYSTEM_ONE_URL=http://127.0.0.1:8009
RECALL_SYSTEM_ONE_MODEL=kev-latest
# Pipeline tunables (retrieval, classify fallback, rerank, Explain's max_tokens, step thresholds). Empty:
# config/recall.json. Set per block, since the hosted reasoning model needs a larger Explain budget.
RECALL_CONFIG=

# Hosted: Cloudflare Workers AI for all three models, with one API token. Replace <ACCOUNT_ID> and
# <WORKERS_AI_TOKEN>. recall builds the Cloudflare URLs, so there is no RECALL_*_URL here, and packs embedding requests
# under bge-m3's request limit itself. See README, "Running on hosted models".
# DATABASE_URL=postgres://recall:recall@localhost:5434/recall
# RECALL_EMBED_BACKEND=workers-ai
# RECALL_EMBED_ACCOUNT_ID=<ACCOUNT_ID>
# RECALL_EMBED_MODEL=@cf/baai/bge-m3
# RECALL_EMBED_KEY=<WORKERS_AI_TOKEN>
# RECALL_EXPLAIN_BACKEND=workers-ai
# RECALL_EXPLAIN_ACCOUNT_ID=<ACCOUNT_ID>
# RECALL_EXPLAIN_MODEL=@cf/qwen/qwen3.8-27b
# RECALL_EXPLAIN_KEY=<WORKERS_AI_TOKEN>
# medium, not low: low with a JSON schema hangs on Workers AI (cloudflare/workers-sdk#16165); unset means xhigh.
# RECALL_EXPLAIN_REASONING_EFFORT=medium
# explain.max_tokens 8192: the reasoning comes out of the same budget, and 2048 cut the JSON answer off.
# RECALL_CONFIG=config/recall-workers-ai.json
# RECALL_SYSTEM_ONE_BACKEND=workers-ai
# RECALL_SYSTEM_ONE_ACCOUNT_ID=<ACCOUNT_ID>
# RECALL_SYSTEM_ONE_MODEL=@cf/cloudflare/clef-flash
# RECALL_SYSTEM_ONE_KEY=<WORKERS_AI_TOKEN>
#
# Alternative System One: Clef Flash on system-one.dev's hosted API (120 decision requests a minute by default).
# RECALL_SYSTEM_ONE_BACKEND=system-one
# RECALL_SYSTEM_ONE_URL=https://system-one.dev
# RECALL_SYSTEM_ONE_MODEL=clef-flash
# RECALL_SYSTEM_ONE_KEY=<SYSTEM_ONE_KEY>

# Bedrock: region and credentials come from the default AWS chain.
# AWS_REGION=us-east-1
# RECALL_EMBED_BACKEND=bedrock
# RECALL_EMBED_MODEL=amazon.titan-embed-text-v2:0
# RECALL_EXPLAIN_BACKEND=bedrock
# RECALL_EXPLAIN_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# No System One: every question is classified open.
# RECALL_SYSTEM_ONE_BACKEND=none

# Corpus: markdown directory (required for ingest)
RECALL_DOCS_DIR=
# Optional base URL for citation links (e.g. GitHub blob URL)
RECALL_DOCS_BASE_URL=
# Optional corpus layers, comma-separated paths under RECALL_DOCS_DIR. Authoritative defaults to the whole root;
# files under neither list are skipped. For example:
# RECALL_DOCS_AUTHORITATIVE=settled
# RECALL_DOCS_EVIDENCE=notes,runbooks
# RECALL_DOCS_SKIP=runbooks/tools
RECALL_DOCS_AUTHORITATIVE=
RECALL_DOCS_EVIDENCE=
RECALL_DOCS_SKIP=

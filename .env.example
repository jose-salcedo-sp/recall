# Copy to .env and adjust paths for your machine:
#   cp .env.example .env

# --- Postgres ---
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall
POSTGRES_DB=recall

# Connection string used by the recall service (host is the compose service name).
DATABASE_URL=postgres://recall:recall@postgres:5432/recall

# --- Model file locations (host paths bind-mounted into containers) ---
# Directory on the host where GGUF weights live. Must contain both files below.
MODELS_HOST_PATH=${HOME}/models

# Generator weights (already present for local dev if you followed plan.md).
GENERATOR_MODEL=qwen2.5-1.5b-q4km.gguf

# Embedder weights — 768-dim nomic-embed-text-v1.5 (matches pgvector vector(768)).
# Download once:
#   mkdir -p "${MODELS_HOST_PATH:-$HOME/models}"
#   curl -L -o "${MODELS_HOST_PATH:-$HOME/models}/nomic-embed-text-v1.5.Q4_K_M.gguf \
#     https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.Q4_K_M.gguf
EMBEDDER_MODEL=nomic-embed-text-v1.5.Q4_K_M.gguf

# Hugging Face cache for the systemone (Laya) classifier — survives image rebuilds.
HF_CACHE_HOST_PATH=${HOME}/.cache/huggingface

# --- Internal service URLs (compose DNS names; usually leave as-is) ---
EMBEDDER_URL=http://embedder:8081
SYSTEM_ONE_URL=http://systemone:8082
GENERATOR_URL=http://generator:8080

# --- Recall ---
RECALL_PORT=8000
RUST_LOG=info,recall=debug

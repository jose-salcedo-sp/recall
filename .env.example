DATABASE_URL=postgres://drew:drew@localhost:5433/drew
RUST_LOG=info,drew=debug
DREW_BIND=127.0.0.1:8080
# key:user_id pairs, comma-separated
DREW_API_KEYS=sk-local-drew:drew
# Optional: user ids that may read any run (audit Slack/API traffic)
DREW_ADMIN_USERS=drew

# Models. Each port names its backend, with no default, so a missing .env fails at startup instead of picking Bedrock.
# A setting the chosen backend does not use is also an error: keep exactly one block below uncommented, and source
# .env in a fresh shell after switching. Check the result with `drew models check`.

# Local: Ollama for embeddings and Explain, Kev for System One. See README, "Running fully locally".
DREW_EMBED_BACKEND=openai-compatible
DREW_EMBED_URL=http://localhost:11434/v1
DREW_EMBED_MODEL=bge-m3
DREW_EXPLAIN_BACKEND=openai-compatible
DREW_EXPLAIN_URL=http://localhost:11434/v1
DREW_EXPLAIN_MODEL=qwen3:14b
DREW_SYSTEM_ONE_BACKEND=system-one
DREW_SYSTEM_ONE_URL=http://127.0.0.1:8009
DREW_SYSTEM_ONE_MODEL=kev-latest
# Pipeline tunables (retrieval, classify fallback, rerank, Explain's max_tokens, step thresholds). Empty:
# config/drew.json. Set per block, since the hosted reasoning model needs a larger Explain budget.
DREW_CONFIG=

# Hosted: Cloudflare Workers AI for all three models, with one API token. Replace <ACCOUNT_ID> and
# <WORKERS_AI_TOKEN>. Drew builds the Cloudflare URLs, so there is no DREW_*_URL here, and packs embedding requests
# under bge-m3's request limit itself. See README, "Running on hosted models".
# DATABASE_URL=postgres://drew:drew@localhost:5434/drew
# DREW_EMBED_BACKEND=workers-ai
# DREW_EMBED_ACCOUNT_ID=<ACCOUNT_ID>
# DREW_EMBED_MODEL=@cf/baai/bge-m3
# DREW_EMBED_KEY=<WORKERS_AI_TOKEN>
# DREW_EXPLAIN_BACKEND=workers-ai
# DREW_EXPLAIN_ACCOUNT_ID=<ACCOUNT_ID>
# DREW_EXPLAIN_MODEL=@cf/qwen/qwen3.8-27b
# DREW_EXPLAIN_KEY=<WORKERS_AI_TOKEN>
# medium, not low: low with a JSON schema hangs on Workers AI (cloudflare/workers-sdk#16165); unset means xhigh.
# DREW_EXPLAIN_REASONING_EFFORT=medium
# explain.max_tokens 8192: the reasoning comes out of the same budget, and 2048 cut the JSON answer off.
# DREW_CONFIG=config/drew-workers-ai.json
# DREW_SYSTEM_ONE_BACKEND=workers-ai
# DREW_SYSTEM_ONE_ACCOUNT_ID=<ACCOUNT_ID>
# DREW_SYSTEM_ONE_MODEL=@cf/cloudflare/clef-flash
# DREW_SYSTEM_ONE_KEY=<WORKERS_AI_TOKEN>
#
# Alternative System One: Clef Flash on system-one.dev's hosted API (120 decision requests a minute by default).
# DREW_SYSTEM_ONE_BACKEND=system-one
# DREW_SYSTEM_ONE_URL=https://system-one.dev
# DREW_SYSTEM_ONE_MODEL=clef-flash
# DREW_SYSTEM_ONE_KEY=<SYSTEM_ONE_KEY>

# Bedrock: region and credentials come from the default AWS chain.
# AWS_REGION=us-east-1
# DREW_EMBED_BACKEND=bedrock
# DREW_EMBED_MODEL=amazon.titan-embed-text-v2:0
# DREW_EXPLAIN_BACKEND=bedrock
# DREW_EXPLAIN_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# No System One: every question is classified open.
# DREW_SYSTEM_ONE_BACKEND=none

# Corpus: Drew-audited markdown directory (required for ingest)
DREW_DOCS_DIR=
# Optional base URL for citation links (e.g. GitHub blob URL)
DREW_DOCS_BASE_URL=
# Optional corpus layers, comma-separated paths under DREW_DOCS_DIR. Authoritative defaults to the whole root;
# files under neither list are skipped. For the DaaS repo:
# DREW_DOCS_AUTHORITATIVE=canon,playbooks,customer
# DREW_DOCS_EVIDENCE=knowledge,runbooks
# DREW_DOCS_SKIP=runbooks/tools
DREW_DOCS_AUTHORITATIVE=
DREW_DOCS_EVIDENCE=
DREW_DOCS_SKIP=
# Slack bot (optional): both tokens required to enable Socket Mode in drew serve
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
